# ===========================================================================
# PRODUCTION secrets. Copy to `secrets.auto.tfvars` (GITIGNORED) and fill in.
#
# Same mechanism as staging (`envs/staging/gcp/secrets.auto.tfvars.example` explains why it is safe
# for Terraform to hold these: `ephemeral` variables feeding a WRITE-ONLY argument, so nothing is
# written to state or to a saved plan). The differences are all about not sharing anything.
#
# ⚠️ EVERY VALUE MUST BE DISTINCT FROM STAGING. Not "should" — a shared JWT secret means a staging
# token authenticates against production, and a shared ENCRYPTION_KEY means a staging database dump
# decrypts production PII. Generate a fresh set; never copy this file across environments.
# ===========================================================================

secret_values = {
  # A SEPARATE Neon project (not a branch): the free plan allows 100 projects, and per-project
  # quotas mean a staging load test cannot eat production's compute hours or storage allowance.
  # Both URLs come from scripts/db-bootstrap.* — the pooled one for the least-privileged app role,
  # the direct one for the owner that runs migrations.
  database_url        = "postgresql://ozari_api:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"
  direct_database_url = "postgresql://<owner>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require"

  jwt_secret         = ""
  jwt_refresh_secret = ""

  # ⚠️ Generate ONCE, back it up outside this machine, and NEVER rotate it while production data
  # exists — every encrypted column becomes permanently unreadable. This is the single value in the
  # system with no recovery path.
  encryption_key = ""

  api_key = ""

  # A production-only Resend key, so revoking a leaked staging key never stops customer email.
  email_key = "re_..."

  # An R2 token scoped to the PRODUCTION bucket only.
  r2_access_key = ""
  r2_secret_key = ""

  # A production OAuth client with the production redirect URI. The consent screen must be
  # PUBLISHED and verified — a client left in Testing expires refresh tokens after ~7 days, which
  # presents as calendars silently going stale a week after launch (DEPLOYMENT.md §3d).
  google_client_id     = ""
  google_client_secret = ""

  # ---------------------------------------------------------------------------
  # REQUIRED whenever manage_github_connection = true (production always).
  #
  # A GitHub personal access token with REPO_ADMIN scope. Cloud Build's Google-managed service agent
  # reads it to establish the 2nd-gen repository connection — it grants nothing to the application.
  # github.com → Settings → Developer settings → Personal access tokens.
  #
  # Treat it as a real credential: it can administer the repository. Prefer a fine-grained token
  # limited to this repo, and set an expiry you will actually notice — an expired token does not
  # break running deploys, it breaks the NEXT one, with an error that points at Cloud Build.
  # ---------------------------------------------------------------------------
  github_oauth_token = "github_pat_..."
}

secret_version_triggers = {
  # Bump a key here together with a new value above to rotate it; the superseded version is
  # destroyed in the same apply.
}
