# ===========================================================================
# Copy to `secrets.auto.tfvars` and fill in. THAT FILE IS GITIGNORED — never commit it, never paste
# its contents into an issue, a chat, or a commit message. This example must stay valueless.
#
# `*.auto.tfvars` is loaded automatically, so `terraform apply` picks it up with no extra flag.
#
# WHY IT IS SAFE for Terraform to hold these at all: `secret_values` is declared `ephemeral` and is
# consumed by a WRITE-ONLY argument (`secret_data_wo`). The value is sent to Secret Manager and then
# forgotten — it is never written to terraform.tfstate and never appears in a saved plan file. That
# was not true before Terraform 1.11, which is why this repo used to push secrets with a separate
# gcloud script.
#
# EVERY KEY BELOW IS REQUIRED. A missing one fails the plan naming the key — deliberately, because
# the alternative is an empty secret version and a container that dies at startup.
# ===========================================================================

secret_values = {
  # --- Database (Neon) ------------------------------------------------------
  # database_url        = the POOLED URL for the least-privileged app role (ozari_api). DML only.
  # direct_database_url = the DIRECT URL for the OWNER role. Migrations and psql only; the running
  #                       app must never receive it. Generated by scripts/db-bootstrap.*.
  database_url        = "postgresql://ozari_api:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"
  direct_database_url = "postgresql://<owner>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require"

  # --- Application secrets --------------------------------------------------
  # Generate with:  openssl rand -hex 32     (or the helper in scripts/new-secrets.*)
  jwt_secret         = ""
  jwt_refresh_secret = ""

  # ⚠️ ENCRYPTION_KEY: exactly 32 bytes of HEX (64 characters). NEVER rotate this once data exists —
  # every *_kms column in the database becomes permanently unreadable. If you regenerate it, you are
  # also throwing the database away, deliberately and in the same operation.
  encryption_key = ""

  # Shared API key for non-browser callers (browser requests are trusted by Origin instead).
  api_key = ""

  # --- Resend (transactional email) ----------------------------------------
  email_key = "re_..."

  # --- Cloudflare R2 credentials -------------------------------------------
  # From an R2 API token scoped to this environment's bucket, Object Read & Write.
  # Minted in the Cloudflare dashboard: a Terraform-created token would land in state.
  r2_access_key = ""
  r2_secret_key = ""

  # --- Google Calendar OAuth client ----------------------------------------
  # Both halves of ONE credential (DEPLOYMENT.md §3d). Leave as empty strings to ship without the
  # calendar integration — the API then answers googleAvailable: false and the settings screen
  # offers only the ICS feed. They must still be PRESENT as keys.
  google_client_id     = ""
  google_client_secret = ""

  # --- Only when manage_github_connection = true ----------------------------
  # Required from the REBUILD onwards, when Terraform starts declaring the Cloud Build GitHub
  # connection instead of referencing the console-created one. A GitHub personal access token with
  # REPO_ADMIN scope; Cloud Build's service agent reads it, and it grants nothing to the app.
  # Leave this key OUT while manage_github_connection is false — the secret does not exist then.
  # github_oauth_token = "github_pat_..."
}

# ---------------------------------------------------------------------------
# Rotation counters. NOT secret — move these into terraform.tfvars (or leave them here) and COMMIT
# the history if you like; a counter tells you when a credential was rotated, which is useful.
#
# To rotate: put the new value above, bump the number here, apply. The old Secret Manager version is
# destroyed in the same operation, which is what keeps the bill flat — Secret Manager charges for
# every enabled version, forever.
# ---------------------------------------------------------------------------

secret_version_triggers = {
  # database_url         = 1
  # direct_database_url  = 1
  # jwt_secret           = 1
  # jwt_refresh_secret   = 1
  # encryption_key       = 1
  # api_key              = 1
  # email_key            = 1
  # r2_access_key        = 1
  # r2_secret_key        = 1
  # google_client_id     = 1
  # google_client_secret = 1
}
