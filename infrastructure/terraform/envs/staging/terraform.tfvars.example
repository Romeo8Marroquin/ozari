# Copy this file to terraform.tfvars and fill in / adjust as needed.
#   cp terraform.tfvars.example terraform.tfvars
# terraform.tfvars is gitignored. None of these values are secret (they are all
# public infra identifiers), but the convention keeps the real file out of Git.
# Secret *payloads* are never stored here — they live in Secret Manager and are
# loaded separately (see infrastructure/scripts/load-secrets-staging.*).

project_id     = "ozari-500103"
project_number = "694756660984"
region         = "northamerica-south1"
environment    = "staging"

service_name = "ozari-api"
# The FRONTEND origin, no trailing slash. Must be a subdomain of the SAME registrable domain the API
# is served from (`api-staging.partyrentalsgt.com`), or the refresh cookie becomes third-party and
# Safari/iOS drops the session after 15 minutes. See DEPLOYMENT.md §3c.
app_host     = "https://staging.partyrentalsgt.com"
node_env     = "staging"
log_level    = "info"

# Cloudflare R2 (public asset storage) — plain, non-secret runtime config. Fill these in your real
# terraform.tfvars (gitignored) so they flow to Cloud Run + the build trigger. The R2 CREDENTIALS
# (access/secret key) are NOT here — load them into Secret Manager (ozari-r2-access-key /
# ozari-r2-secret-key) via gcloud. See DEPLOYMENT.md §3b.
r2_endpoint    = "https://<account-id>.r2.cloudflarestorage.com"
r2_bucket_name = "ozari-assets-staging"
r2_public_url  = "https://<your-r2-public-domain>"

artifact_repository_id = "ozari-images"
image_name             = "ozari-api"

max_instances   = 3
min_instances   = 0
concurrency     = 40
# Keep this at 60 to match cloudbuild.yaml's `--timeout=60` and the live service — or Terraform and
# Cloud Build will thrash the value on every apply/deploy (a backstop above the app's own 30s timeout).
timeout_seconds = 60
cpu             = "1"
memory          = "512Mi"

build_trigger_name         = "ozari-api-dev"
build_trigger_branch_regex = "^dev$"
github_repository_resource = "projects/ozari-500103/locations/northamerica-south1/connections/ozari-github/repositories/Romeo8Marroquin-ozari"
