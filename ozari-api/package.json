{
  "name": "ozari-api",
  "version": "1.0.0",
  "description": "Modern Express TypeScript API for Ozari platform",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dev:debug": "tsx watch --inspect --env-file=.env src/index.ts",
    "build": "prisma generate && tsc --project tsconfig.build.json && tsc-alias --project tsconfig.build.json && node -e \"require('node:fs').cpSync('src/locales','dist/locales',{recursive:true})\"",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:deploy": "pnpm prisma:migrate:deploy",
    "prisma:studio": "prisma studio",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run && vitest run --config vitest.integration.config.ts",
    "cleanup:sessions": "tsx --env-file=.env src/jobs/cleanupExpiredSessions.ts",
    "reconcile:images": "tsx --env-file=.env scripts/reconcile-product-images.ts",
    "purge:evidence": "tsx --env-file=.env scripts/purge-order-evidence.ts",
    "sync:products": "tsx scripts/sync-products.ts",
    "db:seed": "prisma db seed",
    "db:seed:force": "prisma db seed -- --force"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@node-rs/bcrypt": "^1.10.9",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "i18next": "^26.5.2",
    "i18next-fs-backend": "^2.6.9",
    "i18next-http-middleware": "^3.9.9",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "resend": "^6.34.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "openapi-types": "^12.1.3",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsc-alias": "^1.9.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "express",
    "typescript",
    "api",
    "rest",
    "prisma",
    "postgresql"
  ],
  "author": "Ozari Team",
  "license": "MIT"
}
