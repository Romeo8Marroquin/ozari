{
  "name": "ozari-api",
  "version": "1.0.0",
  "description": "Modern Express TypeScript API for Ozari platform",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dev:debug": "tsx watch --inspect --env-file=.env src/index.ts",
    "build": "prisma generate && tsc --project tsconfig.build.json && tsc-alias --project tsconfig.build.json && cpx \"src/locales/**/*\" dist/locales",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:deploy": "pnpm prisma:migrate:deploy",
    "prisma:studio": "prisma studio",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run && vitest run --config vitest.integration.config.ts",
    "cleanup:sessions": "tsx --env-file=.env src/jobs/cleanupExpiredSessions.ts",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@node-rs/bcrypt": "^1.10.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "i18next": "^26.3.1",
    "i18next-fs-backend": "^2.6.6",
    "i18next-http-middleware": "^3.9.7",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.9",
    "cpx": "^1.5.0",
    "eslint": "^10.5.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "openapi-types": "^12.1.3",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "express",
    "typescript",
    "api",
    "rest",
    "prisma",
    "postgresql"
  ],
  "author": "Ozari Team",
  "license": "MIT"
}
