generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model UserRole {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  users User[]

  @@map("user_roles")
}

model User {
  id            Int       @id @default(autoincrement())
  fullNameKms   String    @map("full_name_kms")
  emailSha      String    @unique @map("email_sha")
  emailKms      String    @map("email_kms")
  roleId        Int       @map("role_id")
  passwordSha   String    @map("password_sha")
  mfaSecretKms  String?   @map("mfa_secret_kms")
  mfaEnabledAt  DateTime? @map("mfa_enabled_at")
  mfaLastUsedAt DateTime? @map("mfa_last_used_at")
  termsAccepted Boolean   @default(false) @map("terms_accepted")
  isActive      Boolean   @default(true) @map("is_active")
  updatedAt     DateTime? @updatedAt @map("updated_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  role                 UserRole               @relation(fields: [roleId], references: [id])
  jwtSessions          JwtSession[]
  blacklists           Blacklist[]
  userPhones           UserPhone[]
  addresses            Address[]
  services             Service[]              @relation("ServiceOwner")
  assignedServices     Service[]              @relation("ServiceAssignee")
  serviceStatusChanges ServiceStatusHistory[]
  userAuthProviders    UserAuthProvider[]
  mfaRecoveryCodes     MfaRecoveryCode[]
  passwordResetTokens  PasswordResetToken[]
  calendarConnections  CalendarConnection[]
  calendarFeed         CalendarFeed?

  @@map("users")
}

// A pending password-reset request. Only the SHA-256 hash of the token is stored. Rows are
// short-lived: consumed (hard-deleted) on a successful reset or a new request, and the cleanup job
// purges any abandoned/expired ones — so the table never accumulates stale data. There is no
// `usedAt`: "used" tokens are deleted, not tombstoned (fail-secure, no garbage).
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenSha  String   @unique @map("token_sha")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

model MfaRecoveryCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  codeSha   String    @unique @map("code_sha")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("mfa_recovery_codes")
}

model UserAuthProvider {
  id                  Int       @id @default(autoincrement())
  userId              Int       @map("user_id")
  providerName        String    @map("provider_name")
  providerSubject     String    @map("provider_subject")
  emailExternalKms    String?   @map("email_external_kms")
  emailExternalKmsSha String?   @map("email_external_kms_sha")
  accessTokenKms      String?   @map("access_token_kms")
  refreshTokenKms     String?   @map("refresh_token_kms")
  isActive            Boolean   @default(true) @map("is_active")
  updatedAt           DateTime? @updatedAt @map("updated_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([providerName, providerSubject], name: "uq_user_auth_providers_provider_subject")
  @@unique([userId, providerName], name: "uq_user_auth_providers_user_provider")
  @@map("user_auth_providers")
}

// A user's connected external CALENDAR — the OAuth grant that lets us write their delivery and
// collection events into it.
//
// Deliberately SEPARATE from `user_auth_providers`, which is sign-in identity: different scopes,
// different lifecycle, and revoking a social login must never silently stop someone's schedule from
// arriving. `provider` is a column rather than a second table so a future provider is additive.
//
// The refresh token is the long-lived grant and is encrypted at rest like every other secret here;
// the access token is a minutes-long CACHE, refreshed on demand, and is nullable because a
// connection is perfectly valid before it has ever been used.
model CalendarConnection {
  id       Int    @id @default(autoincrement())
  userId   Int    @map("user_id")
  provider String

  refreshTokenKms      String    @map("refresh_token_kms")
  accessTokenKms       String?   @map("access_token_kms")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")

  // Which calendar events are written into ("primary" = the account's own), and the address the UI
  // shows so an admin can tell WHICH Google account they connected.
  calendarId      String  @default("primary") @map("calendar_id")
  accountEmailKms String? @map("account_email_kms")

  // Paused without being disconnected: the grant survives, the writes stop. Disconnecting deletes
  // the row outright (NO-TRASH — nothing references a connection).
  isActive  Boolean   @default(true) @map("is_active")
  updatedAt DateTime? @updatedAt @map("updated_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, provider], name: "uq_calendar_connections_user_provider")
  @@map("calendar_connections")
}

// A user's private ICS SUBSCRIPTION — the calendar feed Apple Calendar, Outlook and anything else
// can subscribe to. There is no write API for Apple Calendar (see EPIC-2-CALENDAR §1), so a feed is
// not a fallback here: it is THE mechanism for every calendar that is not Google.
//
// The token IS the credential — the feed URL carries no session, because a calendar app sends no
// headers we control. So it is stored exactly like an email address: a SHA for the unique lookup
// and an encrypted copy so the URL can be shown again on a second device. Regenerating replaces
// both, which instantly invalidates every subscription made with the old one.
model CalendarFeed {
  id       Int    @id @default(autoincrement())
  userId   Int    @unique @map("user_id")
  tokenSha String @unique @map("token_sha")
  tokenKms String @map("token_kms")

  isActive  Boolean   @default(true) @map("is_active")
  updatedAt DateTime? @updatedAt @map("updated_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("calendar_feeds")
}

model TokenType {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  jwtSessions JwtSession[]

  @@map("token_types")
}

model JwtSession {
  id          Int       @id @default(autoincrement())
  jti         String    @unique
  deviceUuid  String    @map("device_uuid")
  userId      Int       @map("user_id")
  tokenTypeId Int       @map("token_type_id")
  issuedAt    DateTime  @map("issued_at")
  expiresAt   DateTime  @map("expires_at")
  isActive    Boolean   @default(true) @map("is_active")
  // Rotation lineage (REFRESH rows only; null on access rows and fresh logins): the jti this
  // row's rotation replaced + when. Lets the refresh endpoint tell a LOST-RESPONSE replay of the
  // immediately-previous token (grace → re-rotate) from a genuinely old/stolen token (→ the
  // fail-secure all-sessions nuke). See `appConfig.session.refreshReuseGraceSeconds`.
  previousJti String?   @map("previous_jti")
  rotatedAt   DateTime? @map("rotated_at")

  user      User      @relation(fields: [userId], references: [id])
  tokenType TokenType @relation(fields: [tokenTypeId], references: [id])

  // Indexes for frequent queries in auth middleware
  @@index([userId, isActive]) // Query by user and active status
  @@index([deviceUuid, isActive]) // Query by device and active status
  @@map("jwt_sessions")
}

model BlacklistType {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  blacklists Blacklist[]

  @@map("blacklist_types")
}

model Blacklist {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  blacklistTypeId Int       @map("blacklist_type_id")
  reason          String
  isActive        Boolean   @default(true) @map("is_active")
  updatedAt       DateTime? @updatedAt @map("updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user          User          @relation(fields: [userId], references: [id])
  blacklistType BlacklistType @relation(fields: [blacklistTypeId], references: [id])

  @@index([userId, isActive])
  @@map("blacklist")
}

model UserPhoneType {
  id          Int       @id @default(autoincrement())
  type        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  userPhones UserPhone[]

  @@map("user_phone_types")
}

model UserPhone {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  userPhoneTypeId Int       @map("user_phone_type_id")
  phoneNumberKms  String    @map("phone_number_kms")
  isPrincipal     Boolean   @map("is_principal")
  isActive        Boolean   @default(true) @map("is_active")
  updatedAt       DateTime? @updatedAt @map("updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user      User          @relation(fields: [userId], references: [id])
  phoneType UserPhoneType @relation(fields: [userPhoneTypeId], references: [id])

  @@map("user_phones")
}

model Currency {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  symbol      String
  iso4217Code String    @map("iso_4217_code")
  isActive    Boolean   @default(true) @map("is_active")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  products       Product[]
  services       Service[]
  serviceDetails ServiceDetail[]
  serviceExtras  ServiceExtra[]

  @@map("currencies")
}

model ProductBusinessType {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  products Product[]

  @@map("product_business_type")
}

model ProductCategory {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  products Product[]

  @@map("product_category")
}

// A per-product rent period unit (Hora/Día/Semana/Mes) or "Evento" (a flat rate for the whole
// event, duration-agnostic). Only Alquiler products carry one (see Product.rentTimeUnitId); it is
// the period `rentPrice` is quoted against. Seeded reference data (see prisma/seed.ts).
model RentTimeUnit {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  products Product[]

  @@map("rent_time_units")
}

model Product {
  id                    Int       @id @default(autoincrement())
  name                  String
  description           String?
  productBusinessTypeId Int       @map("product_business_type_id")
  productCategoryId     Int       @map("product_category_id")
  rentPrice             Decimal?  @db.Decimal(15, 2)
  sellPrice             Decimal?  @db.Decimal(15, 2)
  replacementPrice      Decimal?  @map("replacement_price") @db.Decimal(15, 2)
  rentTimeUnitId        Int?      @map("rent_time_unit_id")
  currencyId            Int       @map("currency_id")
  quantity              Int
  isActive              Boolean   @default(true) @map("is_active")
  updatedAt             DateTime? @updatedAt @map("updated_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  businessType   ProductBusinessType @relation(fields: [productBusinessTypeId], references: [id])
  category       ProductCategory     @relation(fields: [productCategoryId], references: [id])
  currency       Currency            @relation(fields: [currencyId], references: [id])
  rentTimeUnit   RentTimeUnit?       @relation(fields: [rentTimeUnitId], references: [id])
  productDetails ProductDetail[]
  productImages  ProductImage[]
  serviceDetails ServiceDetail[]

  @@map("products")
}

// A product photo stored in R2. Supersedes the retired single `Product.imageUrl`: a product has a
// gallery of images ordered by `sortOrder`, exactly one of which is the primary (`isPrimary`) shown
// in the grid/list and opened first on the detail page. `r2Key` is the object key (used to delete
// from R2); `url` is the public read URL. **Hard-deleted, never tombstoned** (the no-trash policy,
// owner decision 2026-07-15): a removed photo's row is deleted in the update/delete transaction and
// its R2 object is removed post-commit — nothing references an image row, so nothing needs a flag.
model ProductImage {
  id        Int       @id @default(autoincrement())
  productId Int       @map("product_id")
  // UNIQUE: one R2 object belongs to exactly one image row — prevents two products from sharing
  // (and later double-deleting) the same object, even if an admin replays a used key.
  r2Key     String    @unique @map("r2_key")
  url       String
  sortOrder Int       @default(0) @map("sort_order")
  isPrimary Boolean   @default(false) @map("is_primary")
  updatedAt DateTime? @updatedAt @map("updated_at")
  createdAt DateTime  @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_images")
}

model ProductDetailType {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  productDetails ProductDetail[]

  @@map("product_detail_types")
}

// A product spec row (color, material, …). **Hard-deleted, never tombstoned** (the no-trash
// policy): pure attributes with no dependents — the declarative update/delete reconciles rows away.
model ProductDetail {
  id                  Int       @id @default(autoincrement())
  productId           Int       @map("product_id")
  productDetailTypeId Int       @map("product_detail_type_id")
  detail              String
  updatedAt           DateTime? @updatedAt @map("updated_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  product    Product           @relation(fields: [productId], references: [id])
  detailType ProductDetailType @relation(fields: [productDetailTypeId], references: [id])

  @@map("product_details")
}

model Country {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  departments CountryDepartment[]

  @@map("countries")
}

model CountryDepartment {
  id          Int       @id @default(autoincrement())
  name        String
  countryId   Int       @map("country_id")
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  country        Country        @relation(fields: [countryId], references: [id])
  municipalities Municipality[]

  @@map("departments")
}

model Municipality {
  id           Int       @id @default(autoincrement())
  name         String
  departmentId Int       @map("department_id")
  description  String?
  isActive     Boolean   @default(true) @map("is_active")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  department CountryDepartment @relation(fields: [departmentId], references: [id])
  zones      Zone[]

  @@map("municipalities")
}

model Zone {
  id             Int       @id @default(autoincrement())
  name           String
  municipalityId Int       @map("municipality_id")
  description    String?
  // The DEFAULT delivery fee for orders whose address is in this zone (owner 2026-07-23: zones drive
  // fee pricing for now). NULL = not configured yet (distinct from 0 = free); a per-address
  // `domicilePrice` overrides it. The order snapshots what was actually charged in `deliveryAmount`.
  deliveryFee    Decimal?  @map("delivery_fee") @db.Decimal(15, 2)
  isActive       Boolean   @default(true) @map("is_active")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  municipality            Municipality            @relation(fields: [municipalityId], references: [id])
  addresses               Address[]
  clientRegistryAddresses ClientRegistryAddress[]

  @@map("zones")
}

model Address {
  id                  Int       @id @default(autoincrement())
  userId              Int       @map("user_id")
  zoneId              Int       @map("zone_id")
  addressKms          String    @map("address_kms")
  coordsKms           String?   @map("coords_kms")
  instructionsKms     String?   @map("instructions_kms")
  domicilePrice       Decimal?  @map("domicile_price") @db.Decimal(15, 2)
  deliveryTimeMinutes Int?      @map("delivery_time_minutes")
  isActive            Boolean   @default(true) @map("is_active")
  updatedAt           DateTime? @updatedAt @map("updated_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  zone Zone @relation(fields: [zoneId], references: [id])

  @@map("addresses")
}

// The purpose of an order (Evento familiar / Evento social / Otro — owner's taxonomy, 2026-07-16;
// admin-parameterizable). `minLeadHours` is the CLIENT-side rule: clients can create an order only
// if delivery is at least this far away, and edit/cancel only until this many hours before
// delivery. The admin has NO time restrictions (only stock + spacing conflicts). `isActive` is a
// publication flag (seeded-lookup pattern), never deletion.
model EventType {
  id           Int       @id @default(autoincrement())
  name         String
  description  String?
  minLeadHours Int       @default(24) @map("min_lead_hours")
  isActive     Boolean   @default(true) @map("is_active")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  services Service[]

  @@map("event_types")
}

// Contact channels for client-registry contacts (WhatsApp / Teléfono / Correo / Otro). Separate
// from `user_phone_types` because registry contacts include non-phone channels (email).
model ContactType {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  clientRegistryContacts ClientRegistryContact[]

  @@map("contact_types")
}

// A WALK-IN client (the WhatsApp/phone people — owner decision 2026-07-16, EPIC-2-ORDERS §9): the
// admin's reusable record for orders on behalf of someone WITHOUT a platform account. Holds the
// RESPONSIBLE person — who receives updates, takes the delivery, hands back at pickup. Conditional
// NO-TRASH: the row soft-deletes (`isActive: false`) ONLY while services reference it and
// hard-deletes otherwise; its contacts/addresses ALWAYS hard-delete — orders SNAPSHOT what they
// used (see Service), so nothing here is load-bearing history.
model ClientRegistry {
  id                       Int       @id @default(autoincrement())
  nameKms                  String    @map("name_kms")
  notesKms                 String?   @map("notes_kms")
  // The client's DEFAULT payment method (owner 2026-07-23): pre-selects the order's method; the
  // order snapshots its own choice. Nullable — a client may have no stated preference.
  preferredPaymentMethodId Int?      @map("preferred_payment_method_id")
  isActive                 Boolean   @default(true) @map("is_active")
  updatedAt                DateTime? @updatedAt @map("updated_at")
  createdAt                DateTime  @default(now()) @map("created_at")

  preferredPaymentMethod PaymentMethod?          @relation(fields: [preferredPaymentMethodId], references: [id])
  contacts               ClientRegistryContact[]
  addresses              ClientRegistryAddress[]
  services               Service[]

  @@map("client_registries")
}

// One contact method of a registry (≥1 per registry, enforced at the app layer; exactly one
// principal). Pure attribute row: hard-deleted on edits, never tombstoned.
model ClientRegistryContact {
  id               Int       @id @default(autoincrement())
  clientRegistryId Int       @map("client_registry_id")
  contactTypeId    Int       @map("contact_type_id")
  valueKms         String    @map("value_kms")
  isPrincipal      Boolean   @default(false) @map("is_principal")
  updatedAt        DateTime? @updatedAt @map("updated_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  clientRegistry ClientRegistry @relation(fields: [clientRegistryId], references: [id])
  contactType    ContactType    @relation(fields: [contactTypeId], references: [id])

  @@index([clientRegistryId])
  @@map("client_registry_contacts")
}

// A registry's delivery address (≥1 per registry, exactly one favorite — app-enforced). `zoneId`
// is OPTIONAL (unlike user addresses): walk-ins are often outside the seeded city zones (e.g.
// Hacienda Real, the owner's village — free delivery there); the encrypted text carries the truth
// and the zone is a future-automation hint. `domicilePrice` is the SUGGESTED delivery fee for this
// address — the order snapshots what was actually charged in `services.delivery_amount`. Pure
// attribute row: hard-deleted on edits, never tombstoned.
model ClientRegistryAddress {
  id               Int       @id @default(autoincrement())
  clientRegistryId Int       @map("client_registry_id")
  zoneId           Int?      @map("zone_id")
  addressKms       String    @map("address_kms")
  coordsKms        String?   @map("coords_kms")
  instructionsKms  String?   @map("instructions_kms")
  domicilePrice    Decimal?  @map("domicile_price") @db.Decimal(15, 2)
  isFavorite       Boolean   @default(false) @map("is_favorite")
  updatedAt        DateTime? @updatedAt @map("updated_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  clientRegistry ClientRegistry @relation(fields: [clientRegistryId], references: [id])
  zone           Zone?          @relation(fields: [zoneId], references: [id])

  @@index([clientRegistryId])
  @@map("client_registry_addresses")
}

// One step of the ORDER LIFECYCLE — and the state machine itself, expressed in DATA (EPIC-2 order
// lifecycle, 2026-07-27). The rows declare their own behavior (position, inventory effect, evidence
// rule, which actual they stamp, display tone) so the admin can rename/recolor/reorder/add steps
// without a deploy, and code keeps ONLY the invariants that can't be data (permissions, the
// transaction, mode-aware completion). Two shapes live here:
//   - PIPELINE steps — the ordered happy path (`sortOrder` 1..N): Pendiente → En ruta → Entregado →
//     Recolectado → Listo.
//   - DISRUPTIVE states — `sortOrder = NULL`, `isDisruptive`: an any-time exit from wherever the
//     order sits (Cancelado today; a future "No entregado" is just another flagged row).
// `isActive` is the seeded-lookup PUBLICATION flag (NO-TRASH), never deletion.
model ServiceStatus {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")

  // --- The declarative machine ---------------------------------------------------------------
  // Pipeline position; NULL = a disruptive off-ramp (Postgres allows many NULLs under @@unique).
  sortOrder    Int?    @map("sort_order")
  // The create-time status (exactly one active pipeline row).
  isInitial    Boolean @default(false) @map("is_initial")
  // Reachable from ANY step; stops the flow and stamps `services.cancelled_at` + reason.
  isDisruptive Boolean @default(false) @map("is_disruptive")
  // How a RENTAL line sitting in this status affects the fleet — THE availability rule, in data:
  //   NONE   = units are available (Listo returns them to the fleet; Cancelado never held).
  //   WINDOW = holds only while `now` falls inside the order's billed [serviceStart, serviceEnd]
  //            (Pendiente: a booking for next week doesn't reduce TODAY's count).
  //   OUT    = holds unconditionally, however late — the units are physically gone (En ruta, on the
  //            truck), out at the event (Entregado), or back but not yet washed (Recolectado; the
  //            washing period, owner decision 2026-07-27 — "listo" is what frees them).
  inventoryHold String @default("NONE") @map("inventory_hold")
  // Advancing INTO this step demands photo evidence; `minEvidence`/`maxEvidence` are the per-status
  // counts, each NULL = fall back to the global `orders.evidenceMin/MaxPhotos` preference.
  requiresEvidence Boolean @default(false) @map("requires_evidence")
  minEvidence      Int?    @map("min_evidence")
  maxEvidence      Int?    @map("max_evidence")
  // Which ORDER MODES this step applies to (ALL | RENTAL | SALE) — mode-aware completion in data: a
  // purchase-only order ends at Entregado because collection/listo are RENTAL-only steps.
  appliesTo String @default("ALL") @map("applies_to")
  // The tracked ACTUAL this step stamps on the order (DELIVERY → `delivered_at`, COLLECTION →
  // `collected_at`), or NULL for a step that tracks nothing. Declared, never derived from an id or a
  // position — an admin inserting "En preparación" simply leaves it NULL.
  tracksEvent String? @map("tracks_event")
  // Chip tone TOKEN from the frontend's fixed palette (amber|indigo|emerald|sky|red|slate|violet|…),
  // never Tailwind classes — design stays in code; an unknown key renders neutral.
  colorKey String? @map("color_key")

  updatedAt DateTime? @updatedAt @map("updated_at")
  createdAt DateTime  @default(now()) @map("created_at")

  services          Service[]
  statusHistoryFrom ServiceStatusHistory[] @relation("StatusHistoryFrom")
  statusHistoryTo   ServiceStatusHistory[] @relation("StatusHistoryTo")
  serviceEvidences  ServiceEvidence[]

  // One status per pipeline slot; the many NULLs (disruptive rows) are unconstrained. Reordering
  // renumbers 1..N in a transaction (via a temporary negative pass, so the unique never trips).
  @@unique([sortOrder])
  @@map("service_status")
}

model PaymentStatus {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  services Service[]

  @@map("payment_status")
}

// HOW an order is paid (owner 2026-07-23): Efectivo / Transferencia for now — the card door stays
// open (add a seed row, no schema change). Chosen per order (a nullable snapshot FK on `services`,
// left NULL until known — payment is a state that can happen later) and optionally the client's
// preferred default on `client_registries`. `isActive` is the seeded-lookup publication flag.
model PaymentMethod {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  services          Service[]
  clientRegistries  ClientRegistry[]

  @@map("payment_methods")
}

// An ORDER (the business term; "service" is the historical table name). Identity is EITHER a
// platform user (`userId`) OR a walk-in registry (`clientRegistryId`) — exactly ONE, enforced at
// the application layer (the migration SQL must stay engine-written, so no hand-added CHECK
// constraint). The operational contact/address fields are SNAPSHOTS — encrypted plain text
// captured at order time (owner decision 2026-07-16, EPIC-2-ORDERS §9): editing a registry or
// user address later must NEVER rewrite an order's history, and snapshotting keeps
// address/contact rows hard-deletable (no-trash). Orders themselves are NEVER deleted, only
// cancelled (`cancelledAt` + status) — they ARE the business history.
model Service {
  id               Int  @id @default(autoincrement())
  userId           Int? @map("user_id")
  clientRegistryId Int? @map("client_registry_id")

  // Snapshots (AES-encrypted like all PII): who receives, how to reach them, where to deliver.
  // `deliveryCoordsKms` is the OPTIONAL map pin ("lat,lng"), snapshotted for the same reason as the
  // text: editing a registry address later must never move a past order's delivery. Nullable
  // forever — the address text is what the business runs on, the pin only removes the last-hundred-
  // metres ambiguity, and most walk-in orders will never have one.
  // `deliveryInstructionsKms` is how to GET IN once you are there ("portón negro", "preguntar por
  // el guardia") — snapshotted for the same reason as the rest: the client's saved address may be
  // edited or deleted later, and a past order must keep what was actually agreed. It is what a pin
  // cannot express, and the only one of these the DRIVER reads on arrival.
  deliveryNameKms         String  @map("delivery_name_kms")
  deliveryContactKms      String  @map("delivery_contact_kms")
  deliveryAddressKms      String  @map("delivery_address_kms")
  deliveryCoordsKms       String? @map("delivery_coords_kms")
  deliveryInstructionsKms String? @map("delivery_instructions_kms")

  description String?
  eventTypeId Int     @map("event_type_id")

  // Logistics, hour precision. `pickupAt` is NULL on purchase-only orders (Q-A, 2026-07-16).
  // `deliveredAt`/`collectedAt` are the tracked ACTUALS behind the ENTREGADO/RECOLECTADO taps;
  // `readyAt` is the explicit final "listo" press that returns the units to the fleet.
  deliveryAt  DateTime  @map("delivery_at")
  pickupAt    DateTime? @map("pickup_at")
  deliveredAt DateTime? @map("delivered_at")
  collectedAt DateTime? @map("collected_at")
  readyAt     DateTime? @map("ready_at")

  // The BILLED period (whole days derived from the delivery→pickup window; pickup time decides).
  serviceStart DateTime @map("service_start")
  serviceEnd   DateTime @map("service_end")

  // The driver this order is assigned to (MVP: admin assigns manually; the admin is also a driver).
  assignedUserId Int? @map("assigned_user_id")

  // Money. `totalAmount` stays authoritative but RECOMPUTABLE from lines + extras + delivery −
  // discount (the FEL/adjustments door). `deliveryAmount` = the fee actually charged (admin-set,
  // distance-based; free inside Hacienda Real — owner 2026-07-16). `depositAmount` = anticipo;
  // `paidAt` records when payment completed (paymentStatus stays the state lookup). Discounts are
  // admin-only and occasional (§2) — nullable, no dedicated flow yet.
  totalAmount    Decimal   @map("total_amount") @db.Decimal(15, 2)
  deliveryAmount Decimal?  @map("delivery_amount") @db.Decimal(15, 2)
  depositAmount  Decimal?  @map("deposit_amount") @db.Decimal(15, 2)
  discountAmount Decimal?  @map("discount_amount") @db.Decimal(15, 2)
  discountReason String?   @map("discount_reason")
  paidAt         DateTime? @map("paid_at")

  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason")

  currencyId       Int       @map("currency_id")
  serviceStatusId  Int       @map("service_status_id")
  paymentStatusId  Int       @map("payment_status_id")
  // HOW it was paid — a nullable snapshot FK to the seeded lookup, left NULL until known (payment is
  // a state that can happen later). Unlike the PII delivery snapshots this is a live FK: the lookup
  // is stable and never deleted.
  paymentMethodId  Int?      @map("payment_method_id")
  comment          String?
  invoiceNumberKms String?   @map("invoice_number_kms")
  isActive         Boolean   @default(true) @map("is_active")
  updatedAt        DateTime? @updatedAt @map("updated_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user           User?                  @relation("ServiceOwner", fields: [userId], references: [id])
  clientRegistry ClientRegistry?        @relation(fields: [clientRegistryId], references: [id])
  assignedUser   User?                  @relation("ServiceAssignee", fields: [assignedUserId], references: [id])
  eventType      EventType              @relation(fields: [eventTypeId], references: [id])
  currency       Currency               @relation(fields: [currencyId], references: [id])
  serviceStatus  ServiceStatus          @relation(fields: [serviceStatusId], references: [id])
  paymentStatus  PaymentStatus          @relation(fields: [paymentStatusId], references: [id])
  paymentMethod  PaymentMethod?         @relation(fields: [paymentMethodId], references: [id])
  serviceDetails ServiceDetail[]
  serviceExtras  ServiceExtra[]
  statusHistory  ServiceStatusHistory[]
  evidences      ServiceEvidence[]

  // The agenda + 1h-spacing checks scan by event time; "my orders" scans by owner/assignee.
  @@index([deliveryAt])
  @@index([pickupAt])
  @@index([userId])
  @@index([clientRegistryId])
  @@index([assignedUserId])
  @@map("services")
}

model ServiceDetail {
  id           Int       @id @default(autoincrement())
  serviceId    Int       @map("service_id")
  productId    Int       @map("product_id")
  quantity     Int
  // Rent-vs-sale SNAPSHOT per line (a product's business type is editable later; the line records
  // how it was ordered): rental lines bill unitary × qty × billed days and get picked up; sale
  // lines bill once and permanently decrement the product's quantity.
  isRental     Boolean   @map("is_rental")
  unitaryPrice Decimal   @map("unitary_price") @db.Decimal(15, 2)
  parcialPrice Decimal   @map("parcial_price") @db.Decimal(15, 2)
  currencyId   Int       @map("currency_id")
  isActive     Boolean   @default(true) @map("is_active")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  service  Service  @relation(fields: [serviceId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])

  @@map("service_details")
}

model ServiceExtra {
  id           Int       @id @default(autoincrement())
  serviceId    Int       @map("service_id")
  name         String
  description  String?
  quantity     Int?
  unitaryPrice Decimal?  @map("unitary_price") @db.Decimal(15, 2)
  parcialPrice Decimal?  @map("parcial_price") @db.Decimal(15, 2)
  currencyId   Int?      @map("currency_id")
  isActive     Boolean   @default(true) @map("is_active")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  service  Service   @relation(fields: [serviceId], references: [id])
  currency Currency? @relation(fields: [currencyId], references: [id])

  @@map("service_extras")
}

// Audit trail of every order status transition (who moved it, from what, to what, when) — cheap,
// answers every dispute (§4). `fromStatusId` is NULL on the creation row. Append-only: rows are
// never updated or deleted.
model ServiceStatusHistory {
  id           Int      @id @default(autoincrement())
  serviceId    Int      @map("service_id")
  fromStatusId Int?     @map("from_status_id")
  toStatusId   Int      @map("to_status_id")
  byUserId     Int      @map("by_user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  service    Service        @relation(fields: [serviceId], references: [id])
  fromStatus ServiceStatus? @relation("StatusHistoryFrom", fields: [fromStatusId], references: [id])
  toStatus   ServiceStatus  @relation("StatusHistoryTo", fields: [toStatusId], references: [id])
  byUser     User           @relation(fields: [byUserId], references: [id])

  @@index([serviceId])
  @@map("service_status_history")
}

// Photo evidence for the ENTREGADO / RECOLECTADO taps (`serviceStatusId` = the phase evidenced).
// Same R2 pattern as `product_images`: presigned browser upload, server-derived URL, unique key,
// hard-deleted rows + post-commit batched object deletes (no-trash).
model ServiceEvidence {
  id              Int      @id @default(autoincrement())
  serviceId       Int      @map("service_id")
  serviceStatusId Int      @map("service_status_id")
  r2Key           String   @unique @map("r2_key")
  url             String
  createdAt       DateTime @default(now()) @map("created_at")

  service       Service       @relation(fields: [serviceId], references: [id])
  serviceStatus ServiceStatus @relation(fields: [serviceStatusId], references: [id])

  @@index([serviceId])
  @@map("service_evidence")
}

// A typed admin preference (owner direction 2026-07-15: every operational "constant" is really a
// preference — spacing, turnaround, reminders, padding, evidence rules, notification cadence).
// Code reads these from day one; the admin settings UI can lag. `value` is text, parsed per
// `valueType` (int | bool | string | json). Seeded create-only in prisma/seed.ts — re-seeding must
// NEVER clobber an admin-edited value. No `isActive`: a preference always has a value.
model AppPreference {
  id          Int       @id @default(autoincrement())
  key         String    @unique
  value       String
  valueType   String    @map("value_type")
  group       String
  description String?
  updatedAt   DateTime? @updatedAt @map("updated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("app_preferences")
}

// A bank account the business asks clients to deposit into — the footer of every quote and order
// document (EPIC-2-DOCUMENTS §6). An admin-managed CATALOG, so it wears the usual
// name/description/is_active shape, with two differences that are the whole point of the model:
//
//  - **The number and the holder are ENCRYPTED at rest** (`*_kms`, the repo-wide PII pattern).
//    They are *semi*-public by nature — they get printed on a document handed to a client — so the
//    requirement was never secrecy, it was "not in the repo, not in an env var, not readable by an
//    anonymous visitor". Encrypted columns behind the Admin-only `/preferences` is exactly that,
//    and unlike an env var the admin can change an account without a redeploy.
//  - **`bankKey` is a TOKEN, not a name** (`banrural`, `bac`, or null): it selects the logo the
//    document renders. Null = "sin logo", always available, so any bank can be entered without us
//    shipping an asset for it.
//
// NO-TRASH: nothing holds a FK to a bank account (a generated document already carries its text),
// so these ALWAYS hard-delete.
model BankAccount {
  id               Int       @id @default(autoincrement())
  name             String
  description      String?
  bankKey          String?   @map("bank_key")
  accountType      String    @map("account_type")
  accountNumberKms String    @map("account_number_kms")
  holderKms        String    @map("holder_kms")
  isActive         Boolean   @default(true) @map("is_active")
  updatedAt        DateTime? @updatedAt @map("updated_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("bank_accounts")
}
