# Server Configuration
NODE_ENV=development
APP_ENV=local
API_HOST=localhost
PORT=3000
API_BASE_PATH=/api
LOG_LEVEL=info

# Frontend URL (for CORS)
APP_HOST=http://localhost:5173

# Database
# Use the Neon pooled URL for the application runtime.
DATABASE_URL=
# Use the Neon direct URL in CI/CD migration steps only. Prisma 7 reads this
# as DATABASE_URL during prisma migrate deploy, not as directUrl in schema.prisma.
DIRECT_DATABASE_URL=

# JWT Secrets
JWT_SECRET=
JWT_REFRESH_SECRET=

# Encryption Key
ENCRYPTION_KEY=

# API Key
API_KEY=
