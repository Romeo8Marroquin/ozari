# Server Configuration
# NODE_ENV drives behavior (development | staging | production). It is the single
# environment switch — there is no separate APP_ENV.
NODE_ENV=development
# API_HOST and PORT are OPTIONAL local overrides. Sensible defaults are applied:
# localhost:3000 locally, and 0.0.0.0:8080 when deployed (Cloud Run injects PORT).
API_HOST=localhost
PORT=3000
LOG_LEVEL=info

# NOTE: the API base path is NOT an env var. It is a code preference
# (appConfig.basePath in src/config/app.ts). Change it in code, not via env.

# Frontend URL (for CORS + the API-key browser-origin check). No trailing slash.
APP_HOST=http://localhost:5173

# Database
# The API (and local Prisma CLI commands) read only DATABASE_URL. Use the Neon
# pooled URL for the application runtime.
# NOTE: the Neon *direct* URL is NOT an API env var — it lives only in the Cloud Build
# pipeline (secret `ozari-direct-database-url`), where the migration step injects it as
# DATABASE_URL for `prisma migrate deploy`. Don't set DIRECT_DATABASE_URL here.
DATABASE_URL=

# JWT Secrets
JWT_SECRET=
JWT_REFRESH_SECRET=

# Encryption Key
ENCRYPTION_KEY=

# Email Key
EMAIL_KEY=

# Cloudflare R2 Keys
R2_PUBLIC_URL=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY=
R2_SECRET_KEY=

# API Key
API_KEY=
