# Server Configuration
# NODE_ENV drives behavior (development | staging | production). It is the single
# environment switch — there is no separate APP_ENV.
NODE_ENV=development
# API_HOST and PORT are OPTIONAL local overrides. Sensible defaults are applied:
# localhost:3000 locally, and 0.0.0.0:8080 when deployed (Cloud Run injects PORT).
API_HOST=localhost
PORT=3000
LOG_LEVEL=info

# NOTE: the API base path is NOT an env var. It is a code preference
# (appConfig.basePath in src/config/app.ts). Change it in code, not via env.

# Frontend URL (for CORS + the API-key browser-origin check). No trailing slash.
APP_HOST=http://localhost:5173

# Database
# The API (and local Prisma CLI commands) read only DATABASE_URL. Use the Neon
# pooled URL for the application runtime.
# NOTE: the Neon *direct* URL is NOT an API env var — it lives only in the Cloud Build
# pipeline (secret `ozari-direct-database-url`), where the migration step injects it as
# DATABASE_URL for `prisma migrate deploy`. Don't set DIRECT_DATABASE_URL here.
DATABASE_URL=

# JWT Secrets
JWT_SECRET=
JWT_REFRESH_SECRET=

# Encryption Key
ENCRYPTION_KEY=

# Email Key
EMAIL_KEY=

# Cloudflare R2 Keys
R2_PUBLIC_URL=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY=
R2_SECRET_KEY=

# API Key
API_KEY=

# Google Calendar (OAuth client — Google Cloud console -> Credentials -> OAuth client ID -> Web app).
# OPTIONAL: when either is empty the calendar module reports `googleAvailable: false` and the settings
# screen offers only the ICS subscription. Authorized redirect URI must match BYTE FOR BYTE:
#   local:    http://localhost:3000/api/calendar/google/callback
#   deployed: https://<api-host>/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OPTIONAL. The API's own public origin, when the request cannot see it (a proxy fronting the API
# under another name). Unset = derived from the live request, which is what keeps the OAuth redirect
# and the ICS feed URL in agreement with the Google console registration. No trailing slash.
API_PUBLIC_URL=
